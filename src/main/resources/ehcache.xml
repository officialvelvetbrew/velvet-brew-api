<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107">

    <service>
        <jsr107:defaults enable-management="false" enable-statistics="false"/>
    </service>

    <cache-template name="defaultTemplate">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache-template>

    <!-- Short TTL: "currently active" offers depend on wall-clock time
         (starts_at/ends_at), so this needs to go stale on its own even
         with zero writes, unlike the other caches here. -->
    <cache-template name="shortLivedTemplate">
        <expiry>
            <ttl unit="minutes">2</ttl>
        </expiry>
        <resources>
            <heap unit="entries">100</heap>
        </resources>
    </cache-template>

    <cache alias="categories" uses-template="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="categoryById" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="menuItems" uses-template="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="menuItemsByCategory" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="menuItemById" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="suppliers" uses-template="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="supplierById" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="inventoryCategories" uses-template="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="inventoryCategoryById" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="offers" uses-template="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="offerById" uses-template="defaultTemplate">
        <key-type>java.lang.Long</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

    <cache alias="activeOffers" uses-template="shortLivedTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
    </cache>

</config>
